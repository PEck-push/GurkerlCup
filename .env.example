# Resend (https://resend.com → API Keys)
RESEND_API_KEY=your_resend_api_key

# Absender-E-Mail (muss in Resend verifiziert sein)
# Während der Entwicklung: onboarding@resend.dev verwenden
RESEND_FROM_EMAIL=gurkerl@yourdomain.at
RESEND_FROM_NAME=Gurkerl Cup 2026
# Optionale Antwort-Adresse (Standard: RESEND_FROM_EMAIL)
