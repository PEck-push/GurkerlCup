# Supabase (https://supabase.com → Projekt Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Resend (https://resend.com → API Keys)
RESEND_API_KEY=your_resend_api_key

# Absender-E-Mail (muss in Resend verifiziert sein)
# Während der Entwicklung: onboarding@resend.dev verwenden
RESEND_FROM_EMAIL=gurkerl@yourdomain.at
RESEND_FROM_NAME=Gurkerl Cup 2026
