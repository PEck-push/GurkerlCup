# ─── Admin-Bereich (/admin) – Turnierverwaltung & Check-In ───
# Gemeinsames Passwort für den Login
ADMIN_PASSWORD=ein_sicheres_passwort
# Supabase Service-Role-Key – NUR serverseitig (Lesen/Löschen, umgeht RLS).
# Supabase → Projekt → Settings → API → "service_role" secret. NIEMALS im Client verwenden!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Turnier-Live-System ───
# Gemeinsames Passwort für die Koordinatoren-Eingabe (/score)
SCORE_PASSWORD=ein_score_passwort
# Passwort für die Beamer-Anzeige (/beamer)
BEAMER_PASSWORD=ein_beamer_passwort
